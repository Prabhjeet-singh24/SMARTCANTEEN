# Copy this file to ".env" (same folder as run.py) and edit the values.
# NEVER commit your real .env file.

# Database Configuration:
# Leave empty for local SQLite (canteen.db), or provide a PostgreSQL connection URL for Supabase/Render:
#
# Option A (Recommended for Render & Windows - IPv4/IPv6 Connection Pooler):
# DATABASE_URL=postgresql://postgres.<project_ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# Option B (Direct Supabase Connection - Note: Supabase direct endpoints are IPv6-only):
# DATABASE_URL=postgresql://postgres:<password>@db.<project_ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=

# Secret used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Admin account created the FIRST time the database is initialised.
ADMIN_NAME=Canteen Admin
ADMIN_EMAIL=admin@smartcanteen.local
ADMIN_PASSWORD=ChangeMe@123

# Server
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false

# Set to true when the site is served over HTTPS (e.g. Render production)
SESSION_COOKIE_SECURE=false

# Optional: extra allowed frontend origins (comma separated)
# CORS_ORIGINS=http://localhost:5500

# Business settings
TAX_RATE=0.05
CANTEEN_CHEFS=6
SERVE_FRONTEND=true
